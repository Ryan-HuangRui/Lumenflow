{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumenflow.local/schemas/benchmark_case.schema.json",
  "title": "Lumenflow benchmark case",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "purpose", "source_fingerprint", "preview_basis", "target_style_id", "tags"],
  "properties": {
    "schema_version": {"const": "lumenflow.benchmark_case.v1"},
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "purpose": {"type": "string", "minLength": 1},
    "source_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "preview_basis": {"$ref": "edit_intent.schema.json#/properties/preview_basis"},
    "target_style_id": {"type": "string", "minLength": 1},
    "tags": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "size_bytes"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
