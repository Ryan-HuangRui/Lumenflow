#!/usr/bin/env bash
set -euo pipefail

SCRIPT_ROOT="$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
PLUGIN_ROOT="${PLUGIN_ROOT:-$SCRIPT_ROOT}"
PLUGIN_DATA="${PLUGIN_DATA:-}"

PYTHON_BIN=""
CANDIDATES=()
if [[ -n "$PLUGIN_DATA" ]]; then
  CANDIDATES+=("$PLUGIN_DATA/venv/bin/python")
fi
CANDIDATES+=("$PLUGIN_ROOT/.venv/bin/python")
SYSTEM_PYTHON="$(command -v python3 || true)"
if [[ -n "$SYSTEM_PYTHON" ]]; then
  CANDIDATES+=("$SYSTEM_PYTHON")
fi

for candidate in "${CANDIDATES[@]}"; do
  if [[ ! -x "$candidate" ]]; then
    continue
  fi
  if ! "$candidate" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 11) else 1)' >/dev/null 2>&1; then
    continue
  fi
  if ! "$candidate" -c 'import mcp, PIL' >/dev/null 2>&1; then
    continue
  fi
  PYTHON_BIN="$candidate"
  break
done

if [[ -z "$PYTHON_BIN" ]]; then
  echo "Lumenflow MCP needs Python 3.11+ with the mcp and Pillow dependencies." >&2
  echo "Create ${PLUGIN_DATA:-<PLUGIN_DATA>}/venv, then run:" >&2
  echo "  <venv>/bin/python -m pip install -e \"$PLUGIN_ROOT\"" >&2
  exit 1
fi

export PYTHONPATH="$PLUGIN_ROOT/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON_BIN" -m lumenflow.mcp "$@"
